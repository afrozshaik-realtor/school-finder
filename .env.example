# Copy this file to .env.local and fill in real values. .env.local is
# gitignored by create-next-app's default .gitignore -- never commit real
# secrets. See docs/DEPLOYMENT.md for where each value comes from.

# --- Public (safe to ship to the browser; still don't commit real ones) ---

# Supabase project URL and anon/publishable key, from:
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: a custom MapLibre style URL. Leave unset to use the app's default.
NEXT_PUBLIC_MAPTILE_STYLE_URL=

# --- Server-only (never exposed to the browser) ---

# Geocoding provider. "none" disables geocoding (address search will
# return an explicit "unavailable" result instead of fabricating one).
GEOCODING_PROVIDER=none
GEOCODIO_API_KEY=

# Off by default. See docs/SECURITY.md and scripts/purge-search-history.ts
# before turning this on in any real deployment.
ENABLE_SEARCH_HISTORY=false
SEARCH_HISTORY_RETENTION_DAYS=90

RATE_LIMIT_REQUESTS_PER_MINUTE=30

# --- Server-only, used ONLY by scripts/ (never read by src/) ---
# Direct Postgres connection string for import/maintenance scripts.
# Supabase dashboard -> Project Settings -> Database -> Connection string
# ("URI" tab, non-pooling / port 5432). Treat this like a password: set it
# in your shell environment or in this untracked .env.local, never commit
# it, never paste it into chat. See scripts/README.md.
SUPABASE_DB_URL=
